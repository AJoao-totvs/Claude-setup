# Python — porta padrao 8000. Ajuste o CMD ao seu framework (FastAPI/Flask/Django).
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
EXPOSE 8000
# FastAPI: uvicorn | Flask: flask run | Django: gunicorn
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
